{
  "title": "Dgraph alpha memory",
  "uid": "dgraph-alpha-memory",
  "description": "Memory, OOM kills and memwatch captures for Dgraph alphas (v24 and v25). See contrib/monitoring/README.md.",
  "tags": [
    "dgraph"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(dgraph_memory_inuse_bytes, namespace)",
          "refId": "ns"
        },
        "definition": "label_values(dgraph_memory_inuse_bytes, namespace)",
        "refresh": 2,
        "sort": 1,
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "pod",
        "type": "query",
        "label": "Alpha",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(dgraph_memory_inuse_bytes{namespace=\"$namespace\"}, pod)",
          "refId": "pod"
        },
        "definition": "label_values(dgraph_memory_inuse_bytes{namespace=\"$namespace\"}, pod)",
        "refresh": 2,
        "sort": 1,
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "OOM kills",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "max by (pod) (increase(container_oom_events_total{namespace=\"$namespace\", pod=~\"$pod\", container=~\".*alpha.*\"}[1m])) > 0",
        "titleFormat": "OOM kill",
        "textFormat": "{{pod}}",
        "step": "30s"
      },
      {
        "name": "memwatch captures",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "sum by (pod, reason) (increase(memwatch_captures_total{namespace=\"$namespace\", pod=~\"$pod\", reason!=\"periodic\"}[1m])) > 0",
        "titleFormat": "memwatch capture",
        "textFormat": "{{pod}} {{reason}}",
        "step": "30s"
      },
      {
        "name": "Alpha restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "max by (pod) (increase(memwatch_target_restarts_total{namespace=\"$namespace\", pod=~\"$pod\"}[1m])) > 0",
        "titleFormat": "alpha restart",
        "textFormat": "{{pod}}",
        "step": "30s"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Memory",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Container memory vs limit",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "From cAdvisor plus memwatch. Anon (Go heap, jemalloc, stacks) is what the kernel can't reclaim and what leads to OOM kills. Working set includes active page cache, so it overstates the risk. memwatch peak anon is the highest value memwatch saw over its window, sampled every second, so it shows spikes between scrapes.",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "drawStyle": "line",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "dgraph:alpha_memory_limit_bytes{namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}} limit"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "dgraph:alpha_working_set_bytes{namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}} working set"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "dgraph:alpha_anon_bytes{namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}} anon"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "dgraph:alpha_file_bytes{namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}} page cache"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "dgraph:alpha_mapped_file_bytes{namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}} mapped files"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (memwatch_rss_window_max_bytes{namespace=\"$namespace\", pod=~\"$pod\", type=\"anon\"})",
          "legendFormat": "{{pod}} memwatch peak anon"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Alpha process memory",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Dgraph's own memory metrics. The dgraph_memory_* gauges refresh once a minute; RSS is read at scrape time. jemalloc reads 0 on binaries built without the jemalloc tag.",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "drawStyle": "line",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (process_resident_memory_bytes{namespace=\"$namespace\", pod=~\"$pod\"} and on (namespace, pod, instance) dgraph_memory_inuse_bytes)",
          "legendFormat": "{{pod}} RSS"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (dgraph_memory_inuse_bytes{namespace=\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} Go heap + stacks in use"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (dgraph_memory_idle_bytes{namespace=\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} Go idle, not released"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (dgraph_memory_alloc_bytes{namespace=\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} jemalloc (off-heap)"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "dgraph:alpha_offheap_bytes{namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}} RSS outside Go heap"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (memwatch_vm_hwm_bytes{namespace=\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} peak RSS since start (VmHWM)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Headroom",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "drawStyle": "line",
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "dgraph:alpha_anon_ratio{namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}} anon / limit"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "dgraph:alpha_working_set_ratio{namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}} working set / limit"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "dgraph:alpha_peak_ratio{namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}} memwatch peak / limit"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Go heap and GC",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "GOMEMLIMIT should sit below the container limit, leaving room for off-heap memory.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "drawStyle": "line",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (go_memory_classes_heap_objects_bytes{namespace=\"$namespace\", pod=~\"$pod\"} and on (namespace, pod, instance) dgraph_memory_inuse_bytes)",
          "legendFormat": "{{pod}} heap objects"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (go_gc_heap_goal_bytes{namespace=\"$namespace\", pod=~\"$pod\"} and on (namespace, pod, instance) dgraph_memory_inuse_bytes)",
          "legendFormat": "{{pod}} heap goal"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (go_gc_gomemlimit_bytes{namespace=\"$namespace\", pod=~\"$pod\"} < 9e18 and on (namespace, pod, instance) dgraph_memory_inuse_bytes)",
          "legendFormat": "{{pod}} GOMEMLIMIT"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "dgraph:alpha_memory_limit_bytes{namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}} container limit"
        }
      ]
    },
    {
      "type": "row",
      "title": "OOM kills, restarts and memwatch captures",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Restarts and OOM kills",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "drawStyle": "bars",
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\", pod=~\"$pod\", container=~\".*alpha.*\"}[5m]))",
          "legendFormat": "{{pod}} restarts"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (increase(container_oom_events_total{namespace=\"$namespace\", pod=~\"$pod\", container=~\".*alpha.*\"}[5m]))",
          "legendFormat": "{{pod}} OOM events"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (increase(memwatch_target_restarts_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{pod}} restarts seen by memwatch"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "memwatch captures",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Each capture is a directory in memwatch's --out-dir with a heap profile, goroutine dump, jemalloc stats, metrics and the recent memory timeline. Restart captures hold the timeline leading into a restart.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod, reason) (increase(memwatch_captures_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{pod}} {{reason}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Queries",
      "id": 9,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Query and mutation rate",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "drawStyle": "line",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod) (rate(dgraph_num_queries_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{pod}} queries/s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod) (rate(dgraph_num_mutations_total{namespace=\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{pod}} mutations/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Query latency",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "drawStyle": "line",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (pod, le) (rate(dgraph_latency_bucket{namespace=\"$namespace\", pod=~\"$pod\", method=\"Server.Query\"}[5m]))) / 1000",
          "legendFormat": "{{pod}} p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (pod, le) (rate(dgraph_latency_bucket{namespace=\"$namespace\", pod=~\"$pod\", method=\"Server.Query\"}[5m]))) / 1000",
          "legendFormat": "{{pod}} p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests in flight",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "drawStyle": "line",
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (dgraph_pending_queries_total{namespace=\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} pending queries + mutations"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (dgraph_active_mutations_total{namespace=\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} active mutations"
        }
      ]
    },
    {
      "type": "row",
      "title": "Writes",
      "id": 13,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Transactions",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
